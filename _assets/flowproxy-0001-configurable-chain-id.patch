@@ -1,3 +1,5 @@
+use std::sync::atomic::{AtomicU64, Ordering};
+
 use alloy_eips::eip7825::MAX_TX_GAS_LIMIT_OSAKA;
 use alloy_hardforks::mainnet::MAINNET_OSAKA_TIMESTAMP;
 use revm_primitives::hardfork::SpecId;
@@ -5,6 +7,20 @@ use revm_primitives::hardfork::SpecId;
 /// Mainnet chain ID.
 pub const MAINNET_CHAIN_ID: u64 = 1;
 
+/// Chain ID transactions must carry. Mainnet unless [`set_chain_id`] is called at startup
+/// (`--chain-id` / `CHAIN_ID`), which is what lets a devnet deployment accept its own traffic.
+static EXPECTED_CHAIN_ID: AtomicU64 = AtomicU64::new(MAINNET_CHAIN_ID);
+
+/// Set the chain ID accepted by [`validate_transaction`]. Call once, before serving.
+pub fn set_chain_id(chain_id: u64) {
+    EXPECTED_CHAIN_ID.store(chain_id, Ordering::Relaxed);
+}
+
+/// The chain ID accepted by [`validate_transaction`].
+pub fn expected_chain_id() -> u64 {
+    EXPECTED_CHAIN_ID.load(Ordering::Relaxed)
+}
+
 /// Maximum initcode to permit in a creation transaction and create instructions.
 ///
 /// Limit of maximum initcode size is `2 * MAX_CODE_SIZE`.
@@ -71,7 +87,7 @@ pub fn validate_transaction(
 
     // Checks for chainid
     if let Some(chain_id) = transaction.chain_id() {
-        if chain_id != MAINNET_CHAIN_ID {
+        if chain_id != expected_chain_id() {
             return Err(ValidationError::ChainIdMismatch);
         }
     }
